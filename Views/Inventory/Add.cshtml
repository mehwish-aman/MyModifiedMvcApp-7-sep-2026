<h2 class="page-title" >Inventory Dashboard</h2>

<!-- table-box ek white card hai (form-box jaisa hi styling) jo neeche Inventory List dikhata hai. 
Isके andar ek <table> hai jisme foreach (var item in Model) se database ki har row ke 
liye ek <tr> banta hai — har row mein item ka data (Name, Value, Date, etc.) aur Action column mein 
Edit ✏️ aur Delete 🗑️ buttons hote hain, jinki Id data-id attribute mein chhupi hoti hai JavaScript 
ke use ke liye.-->


<div class="list-header-row">
    <button type="button" id="addItemBtn">+ Add Item</button>
     <div class="right-controls">
    <div class="search-wrapper">
        <input type="text" id="searchInput" placeholder="Search by item name, company..." />
        <button type="button" id="search-icon-btn"><img src="~/images/search.png" alt="Search" /></button>
    </div>
    <div class="date-filter-wrapper">
        <button type="button" id="dateFilterBtn" class="date-filter-btn">
            🗓️<span id="dateFilterLabel">Filter</span> ▾
        </button>
        <div class="date-filter-dropdown" id="dateFilterDropdown" style="display:none;">
            <label>From <input type="date" id="dateFrom" /></label>
            <label>To <input type="date" id="dateTo" /></label>
            <div class="date-filter-actions">
                <button type="button" id="applyDateFilter">Apply</button>
                <button type="button" id="clearDateFilter">Clear</button>
            </div>
        </div>
    </div>
    <button type="button" id="exportBtn"><img src="~/images/export-img.jpg" alt="Export" />Export CSV</button>
</div>
</div>
    <div id="messageBox"></div>
<div class="add-row-box" id="addRowContainer" style="display:none;">
    <div class="fields-row">
    <input type="text" placeholder="Item Name" data-field="ItemName" required />
    <input type="text" placeholder="Description" data-field="Description" />
    <input type="text" placeholder="Company" data-field="Company" required />
    <select data-field="CategoryId" id="rowCategory" required>
        <option value="">-- Select Category --</option>
    </select>
    <input type="number" step="0.01" id="rowPurchaseValue" placeholder="Purchase Value" data-field="PurchaseValue" required />
    <input type="date" data-field="PurchaseDate" required />
