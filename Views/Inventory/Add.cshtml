/////toool visibility logic
function updateTooltipVisibility(row) {
    row.querySelectorAll(".tooltip-wrapper").forEach(wrapper => {
        const truncateSpan = wrapper.querySelector(".truncate");
        if (truncateSpan.scrollWidth > truncateSpan.clientWidth) {
            wrapper.classList.add("has-overflow");
        } else {
            wrapper.classList.remove("has-overflow");
        }
    });
}

