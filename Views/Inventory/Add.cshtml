<h2 class="page-title" >Inventory Dashboard</h2>

<!-- table-box ek white card hai (form-box jaisa hi styling) jo neeche Inventory List dikhata hai. 
Isके andar ek <table> hai jisme foreach (var item in Model) se database ki har row ke 
liye ek <tr> banta hai — har row mein item ka data (Name, Value, Date, etc.) aur Action column mein 
Edit ✏️ aur Delete 🗑️ buttons hote hain, jinki Id data-id attribute mein chhupi hoti hai JavaScript 
ke use ke liye.-->


<div class="list-header-row">
    <button type="button" id="addItemBtn">+ Add Item</button>
      <div class="search-wrapper">
        <input type="text" id="searchInput" placeholder="Search by item name, company..." />
        <button type="button" class="search-icon-btn" tabindex="-1">🔍</button>
    </div>
</div>
    <div id="messageBox"></div>
<div class="add-row-box" id="addRowContainer" style="display:none;">
    <input type="text" placeholder="Item Name" data-field="ItemName" required />
    <input type="text" placeholder="Description" data-field="Description" />
    <input type="text" placeholder="Company" data-field="Company" required />
    <select data-field="CategoryId" id="rowCategory" required>
        <option value="">-- Select Category --</option>
    </select>
    <input type="number" step="0.01" id="rowPurchaseValue" placeholder="Purchase Value" data-field="PurchaseValue" required />
    <input type="date" data-field="PurchaseDate" required />
    <input type="number" step="0.01" id="rowTax" placeholder="Tax" data-field="Tax" required />
    <input type="number" step="0.01" id="rowTotal" placeholder="Total" data-field="Total" readonly />
    <button type="button" id="rowSaveBtn">💾</button>
    <button type="button" id="rowCancelBtn">✖️</button>
</div>
<div class="table-box">
    <div class="list-header-row" style="justify-content: flex-start;">
        <h3 class="page-title">Inventory List</h3>
    </div>
    <table class="inventory-table">
        <thead>
            <tr>
                <th class="text-left">Item Name</th>
                <th class="text-left">Category</th>
                <th class="text-left">Description</th>
                <th class="text-left">Company</th>
                <th class="text-right">Purchase Value</th>
                <th class="text-center">Purchase Date</th>
                <th class="text-right"> Tax %</th>
                <th class="text-right">Total</th>
                <th>Action</th>
            </tr>
        </thead>
    <tbody id="inventoryTableBody">
        @foreach (var item in Model)
        {
            <tr id="row-@item.Id">
                <td class="text-left">@item.ItemName</td>
                <td class="text-left">@item.CategoryName</td>
                <td class="text-left"> 
                    <span class="tooltip-wrapper">
                        <span class="truncate">@item.Description</span>
                        <span class="tooltip-text">@item.Description</span>
                    </span>
                </td>
                <td class="text-left">@item.Company</td>
                <td class="text-right">@item.PurchaseValue</td>
                <td class="text-center">@item.PurchaseDate.ToShortDateString()</td>
                <td class="text-right">@item.Tax</td>
                <td class="text-right">@item.Total</td>
                <td>
                    <button type="button" class="edit-btn"
                        data-id="@item.Id"
                        data-itemname="@item.ItemName"
                        data-description="@item.Description"
                        data-purchasevalue="@item.PurchaseValue"
                        data-purchasedate="@item.PurchaseDate.ToString("yyyy-MM-dd")"
                        data-tax="@item.Tax"
                        data-company="@item.Company"
                        data-categoryid="@item.CategoryId">✏️</button>
                    <button type="button" class="delete-btn" data-id="@item.Id">🗑️</button>
                </td>
            </tr>
        }
</tbody>
    </table>
    <div class="pagination-controls" id="paginationControls">

</div>
</div>

<!-- Modal / Popup -->
<!--.modal-overlay — Poori screen ko cover karne wala dark transparent background (rgba(0,0,0,0.5)), 
position: fixed se scroll ke sath move nahi hota, default display: none (invisible), JavaScript ise 
flex karke dikhati hai jab popup khulna ho.
.modal-box — Andar ka safed card jisme actual popup content hota hai (icon, message, Yes/No buttons) 
rounded corners, shadow, aur fixed width ke saath center mein rehta hai.-->

<!--Save Modal (#confirmModal) aur Delete Modal (#deleteModal) dono same pattern follow karte hain:
• SVG icon (green checkmark ya red cross)
• Confirmation text
• Yes/No buttons
Dono alag alag IDs rakhte hain taake independently control ho sakein (ek dusre ko disturb na karein).-->
<div class="modal-overlay" id="confirmModal">
    <div class="modal-box">
         <div class="check-icon">
            <svg viewBox="0 0 52 52" width="60" height="60">
                <circle cx="26" cy="26" r="25" fill="#198754"/>
                <path fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" d="M14 27l7 7 16-16"/>
            </svg>
        </div>
        <p>Are you sure you want to save?</p>
        <div class="modal-buttons">
            <button class="btn-no" id="noBtn">No</button>
            <button class="btn-yes" id="yesBtn">Yes</button>
        </div>
    </div>
</div>


<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <div class="check-icon">
            <svg viewBox="0 0 52 52" width="60" height="60">
                <circle cx="26" cy="26" r="25" fill="#dc3545"/>
                <path fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" d="M17 17l18 18M35 17l-18 18"/>
            </svg>
        </div>
        <p>Are you sure you want to delete this item?</p>
        <div class="modal-buttons">
            <button class="btn-no" id="cancelDeleteBtn">No</button>
            <button class="btn-yes" id="confirmDeleteBtn">Yes</button>
        </div>
    </div>
</div>



<!--JS script-->
<script>
    /* Teeno numeric fields ko JavaScript variables mein save kr liya, taake unko baar-baar 
dhoondhna na pade*/
/*Pehle saare zaroori elements (saveBtn, modal, yesBtn, noBtn, form, messageBox) ko getElementById se 
pakda gaya. */
const saveBtn = document.getElementById("saveBtn");
const modal = document.getElementById("confirmModal");
const yesBtn = document.getElementById("yesBtn");
const noBtn = document.getElementById("noBtn");
const form = document.getElementById("inventoryForm");
const messageBox = document.getElementById("messageBox");
const deleteModal = document.getElementById("deleteModal");
const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");
const cancelDeleteBtn = document.getElementById("cancelDeleteBtn");
const validationError = document.getElementById("validationError");
const purchaseValueInput = document.getElementById("rowPurchaseValue");
const taxInput = document.getElementById("rowTax");
const totalInput = document.getElementById("rowTotal");
const rowsPerPage=8;
let currentPage=1;

let editingItemId = null; /*null matlab "naya item add ho raha hai", number matlab "is Id ko edit 
kiya ja raha hai*/
//let itemIdToDelete = null; ek variable jo temporarily yaad rakhta hai 
//"abhi konsi item delete honi hai" jab tak "Yes" na dabe.
let itemIdToDelete = null;



////////////LOgic for add butten and hidden row , save and cancel//////////////

//          add button par row clone karne ka logic
const addItemBtn = document.getElementById("addItemBtn");
const addRowContainer = document.getElementById("addRowContainer");

addItemBtn.addEventListener("click", function () {
    addRowContainer.style.display = "flex";
});


///////////////////CANCEL BUTTON LOGIC-container gaib row khali ho r gaib ho jaye
const rowCancelBtn = document.getElementById("rowCancelBtn");
rowCancelBtn.addEventListener("click", function () {
    addRowContainer.style.display = "none";
    addRowContainer.querySelectorAll("[data-field]").forEach(input => input.value = "");
    editingItemId = null;
});


//////////////Row save button logic 
const rowSaveBtn = document.getElementById("rowSaveBtn");
rowSaveBtn.addEventListener("click", function () {
    const inputs = addRowContainer.querySelectorAll("[data-field]");

    const formData = new FormData();
    inputs.forEach(input => {
        formData.append(input.getAttribute("data-field"), input.value);
    });

    let isValid = true;
    inputs.forEach(input => {
        if (input.hasAttribute("required") && !input.checkValidity()) {
            isValid = false;
            input.reportValidity();
        }
    });
    if (!isValid) return;

    const url = editingItemId ? "/Inventory/Update/" + editingItemId : "/Inventory/Save";
    const categorySelect = addRowContainer.querySelector('[data-field="CategoryId"]');
    const selectedCategoryName = categorySelect.options[categorySelect.selectedIndex].text;
    fetch(url, { method: "POST", body: formData })
        .then(response => response.json())
        .then(data => {
            addRowContainer.style.display = "none";
            inputs.forEach(input => input.value = "");

            messageBox.innerText = data.message;
            messageBox.style.display = "block";
            setTimeout(function () { messageBox.style.display = "none"; }, 3000);

            if (editingItemId) {
                const row = document.getElementById("row-" + data.id);
                row.innerHTML = `
                    <td class="text-left">${data.itemName}</td>
                     <td class="text-left">${selectedCategoryName}</td>
                    <td class="text-left">${data.description}</td>
                    <td class="text-left">${data.company}</td>
                    <td class="text-right">${data.purchaseValue}</td>
                    <td class="text-center">${data.purchaseDate}</td>
                    <td class="text-right">${data.tax}</td>
                    <td class="text-right">${data.total}</td>
                    <td>
                        <button type="button" class="edit-btn" data-id="${data.id}" data-itemname="${data.itemName}" data-description="${data.description}" data-purchasevalue="${data.purchaseValue}" data-purchasedate="${data.rawDate}" data-tax="${data.tax}" data-company="${data.company}" data-categoryid="${data.categoryId}">✏️</button>
                        <button type="button" class="delete-btn" data-id="${data.id}">🗑️</button>
                    </td>
                `;
                attachRowEvents(row);
                editingItemId = null;
            } else {
                const tableBody = document.getElementById("inventoryTableBody");
                const newRow = document.createElement("tr");
                newRow.id = "row-" + data.id;
                newRow.innerHTML = `
                    <td class="text-left">${data.itemName}</td>
                     <td class="text-left">${selectedCategoryName}</td>
                    <td class="text-left">${data.description}</td>
                    <td class="text-left">${data.company}</td>
                    <td class="text-right">${data.purchaseValue}</td>
                    <td class="text-center">${data.purchaseDate}</td>
                    <td class="text-right">${data.tax}</td>
                    <td class="text-right">${data.total}</td>
                    <td>
                        <button type="button" class="edit-btn" data-id="${data.id}" data-itemname="${data.itemName}" data-description="${data.description}" data-purchasevalue="${data.purchaseValue}" data-purchasedate="${data.rawDate}" data-tax="${data.tax}" data-company="${data.company}"  data-categoryid="${data.categoryId}">✏️</button>
                        <button type="button" class="delete-btn" data-id="${data.id}">🗑️</button>
                    </td>
                `;
                tableBody.prepend(newRow);
                attachRowEvents(newRow);
            }
        })
        .catch(error => {
            messageBox.innerText = "Something went wrong!";
            messageBox.style.display = "block";
            setTimeout(function () { messageBox.style.display = "none"; }, 3000);
        });
});


function blockScientificNotation(inputElement) {
    inputElement.addEventListener("keydown", function (e) {
        if (e.key === "e" || e.key === "E" || e.key === "+" || e.key === "-") {
            e.preventDefault();
        }
    });
}


                     /*Function for Calulating Total Purchse Value*/
function calculateTotal() {  
/*parseFloat(...) input ki value string hoti hai (jaise "500"), isko number mein convert karta hai
|| 0 agar field khali ho (parseFloat NaN de), to 0 use karo, crash na ho*/
const purchaseValue = parseFloat(purchaseValueInput.value) || 0;
const taxPercent = parseFloat(taxInput.value) || 0;
/*Tax % formula hai. tofixed 2 decimal places tk round krta hai*/
const taxAmount = (purchaseValue * taxPercent) / 100; 
totalInput.value = (purchaseValue + taxAmount).toFixed(2);
}

            /* Numeric fields ko max 6 digits tak limit karo*/
/*Ye ek reusable function hai (kisi bhi input aur limit ke sath call kar sakte ho). This value.length 
kitne characters ho gaye. .slice(0, maxDigits) extra characters kaat deta hai agar limit se zyada hon.*/
        
function limitNumberInput(inputElement, maxDigits) {
inputElement.addEventListener("input", function () {
    if (this.value.length > maxDigits) {
        this.value = this.value.slice(0, maxDigits);
    }
    });
    }

limitNumberInput(purchaseValueInput, 6);
limitNumberInput(taxInput, 2);

blockScientificNotation(purchaseValueInput);
blockScientificNotation(taxInput);


/*Jab bhi user in fields mein type kare "input" event = har keystroke pe, 
calculateTotal function chalta hai, real-time update.*/
purchaseValueInput.addEventListener("input", calculateTotal);
taxInput.addEventListener("input", calculateTotal);

/*  Row ke andar edit/delete buttons ko event listeners dene wala reusable function ye func 3 different jaga use ho raha hai*/
function attachRowEvents(row) {
    row.querySelector(".delete-btn").addEventListener("click", function () {
    itemIdToDelete = this.getAttribute("data-id");
    deleteModal.style.display = "flex";  });

    row.querySelector(".edit-btn").addEventListener("click", function () {
    editingItemId = this.getAttribute("data-id");

    addRowContainer.querySelector('[data-field="ItemName"]').value = this.getAttribute("data-itemname");
    addRowContainer.querySelector('[data-field="Description"]').value = this.getAttribute("data-description");
    addRowContainer.querySelector('[data-field="PurchaseValue"]').value = this.getAttribute("data-purchasevalue");
    addRowContainer.querySelector('[data-field="PurchaseDate"]').value = this.getAttribute("data-purchasedate");
    addRowContainer.querySelector('[data-field="Tax"]').value = this.getAttribute("data-tax");
    addRowContainer.querySelector('[data-field="Company"]').value = this.getAttribute("data-company");
    addRowContainer.querySelector('[data-field="CategoryId"]').value = this.getAttribute("data-categoryid");
    calculateTotal();

    addRowContainer.style.display = "flex";
});
}
    // Page load ke waqt jo rows hain, unko events do
document.querySelectorAll("#inventoryTableBody tr").forEach(function (row) {
    attachRowEvents(row);
});


// Modal logic


  // Ek row ka HTML template banane wala helper function (Add aur Update dono use karenge)
   // Ek row ka HTML template banane wala helper function (Add aur Update dono use karenge)
function buildRowHtml(data) {
    return `
        <td class="text-left truncate">${data.itemName}</td>
        <td class="text-left">
        <span class="tooltip-text">${data.description}</span>
        </span> 
        </td>
         <td class="text-left">${data.company}</td>
        <td class="text-right">${data.purchaseValue}</td>
        <td class="text-center">${data.purchaseDate}</td>
        <td class="text-right">${data.tax}</td>
        <td class="text-right">${data.total}</td>
       
        <td>
            <button type="button" class="edit-btn"
                data-id="${data.id}"
                data-itemname="${data.itemName}"
                data-description="${data.description}"
                data-purchasevalue="${data.purchaseValue}"
                data-purchasedate="${data.rawDate}"
                data-tax="${data.tax}"
                data-company="${data.company}" 
                data-categoryid="${data.categoryId}">✏️</button>
            <button type="button" class="delete-btn" data-id="${data.id}">🗑️</button>
        </td>
    `;
}

@*
               // Save/Update button click — pehle validation check
