function renderStagedFiles() {
    stagedFilesList.innerHTML = "";

    existingFiles.forEach(file => {
        const fileTag = document.createElement("div");
        fileTag.className = "staged-file-tag";
        fileTag.innerHTML = `<span>${file.fileName}</span> <button type="button" class="remove-existing-file" data-id="${file.id}">✖️</button>`;
        stagedFilesList.appendChild(fileTag);
    });

    stagedFiles.forEach((file, index) => {
        const fileTag = document.createElement("div");
        fileTag.className = "staged-file-tag";
        fileTag.innerHTML = `<span>${file.name}</span> <button type="button" class="remove-staged-file" data-index="${index}">✖️</button>`;
        stagedFilesList.appendChild(fileTag);
    });

    document.querySelectorAll(".remove-staged-file").forEach(btn => {
        btn.addEventListener("click", function () {
            const idx = parseInt(this.getAttribute("data-index"));
            stagedFiles.splice(idx, 1);
            renderStagedFiles();
        });
    });

    document.querySelectorAll(".remove-existing-file").forEach(btn => {
        btn.addEventListener("click", function () {
            const attachmentId = this.getAttribute("data-id");
            fetch("/Attachments/Delete/" + attachmentId, { method: "POST" })
                .then(response => response.json())
                .then(data => {
                    existingFiles = existingFiles.filter(f => f.id != attachmentId);
                    renderStagedFiles();
                     updateAttachmentBadge(editingItemId);
                })
                .catch(error => console.error("Delete failed:", error));
        });
    });
}

////function for blocking scientific notation

function blockScientificNotation(inputElement) {
    inputElement.addEventListener("keydown", function (e) {
        if (e.key === "e" || e.key === "E" || e.key === "+" || e.key === "-") {
            e.preventDefault();
        }
    });
}


                     /*Function for Calulating Total Purchse Value*/
function calculateTotal() {  
/*parseFloat(...) input ki value string hoti hai (jaise "500"), isko number mein convert karta hai
|| 0 agar field khali ho (parseFloat NaN de), to 0 use karo, crash na ho*/
const purchaseValue = parseFloat(purchaseValueInput.value) || 0;
const taxPercent = parseFloat(taxInput.value) || 0;
/*Tax % formula hai. tofixed 2 decimal places tk round krta hai*/
const taxAmount = (purchaseValue * taxPercent) / 100; 
totalInput.value = (purchaseValue + taxAmount).toFixed(2);
}

            /* Numeric fields ko max 6 digits tak limit karo*/
/*Ye ek reusable function hai (kisi bhi input aur limit ke sath call kar sakte ho). This value.length 
kitne characters ho gaye. .slice(0, maxDigits) extra characters kaat deta hai agar limit se zyada hon.*/
        
function limitNumberInput(inputElement, maxDigits) {
inputElement.addEventListener("input", function () {
    if (this.value.length > maxDigits) {
        this.value = this.value.slice(0, maxDigits);
    }
    });
    }

limitNumberInput(purchaseValueInput, 6);
limitNumberInput(taxInput, 2);

