<!--JS script-->
<script>
    /* Teeno numeric fields ko JavaScript variables mein save kr liya, taake unko baar-baar 
dhoondhna na pade*/
/*Pehle saare zaroori elements (saveBtn, modal, yesBtn, noBtn, form, messageBox) ko getElementById se 
pakda gaya. */
const saveBtn = document.getElementById("saveBtn");
const modal = document.getElementById("confirmModal");
const yesBtn = document.getElementById("yesBtn");
const noBtn = document.getElementById("noBtn");
const form = document.getElementById("inventoryForm");
const messageBox = document.getElementById("messageBox");
const deleteModal = document.getElementById("deleteModal");
const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");
const cancelDeleteBtn = document.getElementById("cancelDeleteBtn");
const validationError = document.getElementById("validationError");
const purchaseValueInput = document.getElementById("rowPurchaseValue");
const taxInput = document.getElementById("rowTax");
const totalInput = document.getElementById("rowTotal");
const rowsPerPage=6;
let currentPage=1;

let editingItemId = null; /*null matlab "naya item add ho raha hai", number matlab "is Id ko edit 
kiya ja raha hai*/
//let itemIdToDelete = null; ek variable jo temporarily yaad rakhta hai 
//"abhi konsi item delete honi hai" jab tak "Yes" na dabe.
let itemIdToDelete = null;

////////////LOgic for add butten and hidden row , save and cancel//////////////

//          add button par row clone karne ka logic
const addItemBtn = document.getElementById("addItemBtn");
const addRowContainer = document.getElementById("addRowContainer");

addItemBtn.addEventListener("click", function () {
    addRowContainer.style.display = "flex";
});

///////////////////CANCEL BUTTON LOGIC-container gaib row khali ho r gaib ho jaye
const rowCancelBtn = document.getElementById("rowCancelBtn");
rowCancelBtn.addEventListener("click", function () {
    addRowContainer.style.display = "none";
    addRowContainer.querySelectorAll("[data-field]").forEach(input => input.value = "");
    editingItemId = null;
    stagedFiles = [];
    existingFiles = [];
    renderStagedFiles();
    document.getElementById("attachmentError").style.display = "none";
});


///load existing attachments for the item being edited, ye function fetch se server se
// existing attachments ko load karta hai aur existingFiles array mein store karta hai. renderStagedFiles() f
//unction ko call karke UI mein dikhata hai.
let existingFiles = [];

function loadExistingAttachments(itemId) {
    existingFiles = [];
    fetch("/Attachments/GetByItem?inventoryItemId=" + itemId)
        .then(response => response.json())
        .then(data => {
            existingFiles = data;
            renderStagedFiles();
        })
        .catch(error => console.error("Attachments load nahi hui:", error));
}

/////staged files ko upload karne ka function, ye function har file ke liye ek 
//FormData banata hai aur fetch se POST request bhejta hai.
function uploadStagedFiles(itemId) {
    const uploadPromises = stagedFiles.map(file => {
        const fileFormData = new FormData();
        fileFormData.append("inventoryItemId", itemId);
        fileFormData.append("file", file);
        return fetch("/Attachments/Upload", { method: "POST", body: fileFormData });
    });

    Promise.all(uploadPromises)
        .then(() => {
            stagedFiles = [];
            renderStagedFiles();
            updateAttachmentBadge(itemId);
        })
        .catch(error => console.error("No Attachments", error));
}

function updateAttachmentBadge(itemId) {
    fetch("/Attachments/GetByItem?inventoryItemId=" + itemId)
        .then(response => response.json())
        .then(data => {
            const badge = document.querySelector(`.attachment-badge[data-id="${itemId}"]`);
            if (badge) {
                badge.textContent = "📎 " + data.length;
            }
        });
}


//////////////Row save button logic 
const rowSaveBtn = document.getElementById("rowSaveBtn");
rowSaveBtn.addEventListener("click", function () {
    const inputs = addRowContainer.querySelectorAll("[data-field]");

    const formData = new FormData();
    inputs.forEach(input => {
        formData.append(input.getAttribute("data-field"), input.value);
    });

    let isValid = true;
    inputs.forEach(input => {
        if (input.hasAttribute("required") && !input.checkValidity()) {
            isValid = false;
            input.reportValidity();
