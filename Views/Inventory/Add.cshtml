//search logic
const searchInput = document.getElementById("searchInput"); 
//jab b user input mein key press kry hr br yeh function chalay
searchInput.addEventListener("input", function () {       
    const searchTerm = this.value.toLowerCase(); //lower case mei convert takay small capital dono ko consider kry
    const rows = document.querySelectorAll("#inventoryTableBody tr");   //table ki sari rows aik list mein rakh ley
//har row ko check krny kay liye foreach function
    rows.forEach(function (row) {
        const rowText = row.textContent.toLowerCase(); //row ky sarey coulmns ko lower mein convert kiya
        //checks row mein searche ditem mojood hai ya nahin agar hai to 
        if (rowText.includes(searchTerm)) {
            row.classList.remove("search-hidden");  //to show ho jaye row   --old   row.style.display= "" 
        } else {
            row.classList.add("search-hidden"); //nahin hai match to chup jaye row
        }
    });
    currentPage = 1; // Search karte waqt wapis page 1 pe le aao
    renderPagination();
});





function loadCategories() {
    fetch("/Inventory/GetCategories")
        .then(response => response.json())
        .then(data => {
            const categorySelect = document.getElementById("rowCategory");
            data.forEach(cat => {
                const option = document.createElement("option");
                option.value = cat.id;
                option.textContent = cat.name;
                categorySelect.appendChild(option);
            });
        })
        .catch(error => console.error("Categories load nahi hui:", error));
}

loadCategories(); // page load hote hi call ho jaye


//pagination logic
//wahi rows jo fun sy match ho rahi hain ya sab agar search khali hai
function getVisibleRows(){
    const allRows =Array.from(document.querySelectorAll("#inventoryTableBody tr"));
    return allRows.filter(row=>!row.classList.contains("search-hidden") );
}

function renderPagination(){
    const visibleRows= getVisibleRows();
    const totalPages=Math.ceil(visibleRows.length  / rowsPerPage);

    //agar current page total pages sy zyada ho gaye ,search ky bd to reset
    if (currentPage>totalPages){
        currentPage =totalPages || 1;
    }
  //pehlay sari rows hide , phir current page show ho sirf
  visibleRows.forEach(function(row,index){
    const start = (currentPage -1 )* rowsPerPage;
    const end= start +rowsPerPage;
    row.style.display= (index >=start && index < end)  ?"" :"none";
  });
  //pagination buttons creation
  const controls =document.getElementById("paginationControls")
  controls.innerHTML ="";
   //previous button
   const prevBtn =document.createElement("button");
   prevBtn.innerText = "Previous";
   prevBtn.disabled =currentPage===1;
   prevBtn.addEventListener("click",function(){
    currentPage--;
    renderPagination();
   });
   controls.appendChild(prevBtn);

      // Sirf current page ke aas-paas ke numbers dikhao
    const maxVisible = 5;
    let startPage = Math.max(1, currentPage - 2);
    let endPage = Math.min(totalPages, startPage + maxVisible - 1);

    if (endPage - startPage + 1 < maxVisible) {
        startPage = Math.max(1, endPage - maxVisible + 1);
    }

    for (let i = startPage; i <= endPage; i++) {
        const pageBtn = document.createElement("button");
        pageBtn.innerText = i;
        if (i === currentPage) {
            pageBtn.classList.add("active");
        }
        pageBtn.addEventListener("click", function () {
            currentPage = i;
            renderPagination();
        });
        controls.appendChild(pageBtn);
    }
    //next button 
    const nextBtn =document.createElement("button");
    nextBtn.innerText = "Next";
    nextBtn.disabled =currentPage ===totalPages  || totalPages ===0;
    nextBtn.addEventListener("click",function(){
        currentPage++;
        renderPagination();
     });
     controls.appendChild(nextBtn);
}
renderPagination();  
</script>