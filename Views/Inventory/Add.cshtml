let currentPopup = null;

function showAttachmentPopup(badgeElement, itemId) {
    if (currentPopup) {
        currentPopup.remove();
        currentPopup = null;
    }

    const popup = document.createElement("div");
    popup.className = "attachment-popup";
    popup.innerHTML = "Loading...";
    document.body.appendChild(popup);

    const rect = badgeElement.getBoundingClientRect();
    popup.style.top = (rect.bottom + window.scrollY + 5) + "px";
    popup.style.left = (rect.left + window.scrollX) + "px";

    currentPopup = popup;

    fetch("/Attachments/GetByItem?inventoryItemId=" + itemId)
        .then(response => response.json())
        .then(data => {
            if (data.length === 0) {
                popup.innerHTML = "<div class='popup-empty'>No acttachments found</div>";
            } else {
                popup.innerHTML = data.map(f => `<div class="popup-file">${f.fileName}</div>`).join("");
            }
        })
        .catch(error => {
            popup.innerHTML = "<div class='popup-empty'>Load nahi ho saka</div>";
        });
}

