//export logic incorporating search

function exportToCSV() {
    const rows = document.querySelectorAll("#inventoryTableBody tr:not(.search-hidden)");
    
    let csv = "Item Name,Category,Description,Company,Purchase Value,Purchase Date,Tax,Total\n";
    
    rows.forEach(row => {
        const cells = row.querySelectorAll("td");
        const itemName = cells[0].querySelector(".tooltip-text")
            ? cells[2].querySelector(".tooltip-text").textContent.trim()
            : cells[2].textContent.trim();
        const category = cells[1].textContent.trim();
        const description = cells[2].querySelector(".tooltip-text")
            ? cells[2].querySelector(".tooltip-text").textContent.trim()
            : cells[2].textContent.trim();
        const company = cells[3].querySelector(".tooltip-text")
            ? cells[2].querySelector(".tooltip-text").textContent.trim()
            : cells[2].textContent.trim();
        const purchaseValue = cells[4].textContent.trim();
        const tax = cells[6].textContent.trim();
        const total = cells[7].textContent.trim();
        const purchaseDate = cells[5].textContent.trim();

        csv += `"${itemName}","${category}","${description}","${company}","${purchaseValue}","${tax}","${total}","${purchaseDate}"\n`;
    });

    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = "inventory_export.csv";
    link.click();
    URL.revokeObjectURL(url);
}

document.getElementById("exportBtn").addEventListener("click", exportToCSV);


