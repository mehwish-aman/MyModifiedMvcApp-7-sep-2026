                        <span class="truncate">@item.Description</span>
                        <span class="tooltip-text">@item.Description</span>
                    </span>
                </td>
                <td class="text-left">
                    <span class="tooltip-wrapper">
                        <span class="truncate">@item.Company</span>
                        <span class="tooltip-text">@item.Company</span>
                    </span>
                </td>
                <td class="text-right">@item.PurchaseValue</td>
