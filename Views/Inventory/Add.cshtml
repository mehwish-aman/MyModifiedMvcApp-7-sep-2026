    <input type="number" step="0.01" id="rowTotal" placeholder="Total" data-field="Total" readonly />
    <button type="button" id="rowSaveBtn">💾</button>
    <button type="button" id="rowCancelBtn">✖️</button>
    </div>
    <div class="attachment-section">
    <button type="button" id="fileUploadBtn">📎Upload File</button>
    <input type="file" id="fileInput" multiple style="display:none;" accept=".pdf,.csv,.xls,.xlsx,.xml, .txt" />
